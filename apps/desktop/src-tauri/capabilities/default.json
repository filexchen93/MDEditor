{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Base capability for the main MDEditor window; no direct filesystem or network access, with scoped external URL opening.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-message",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" },
        { "url": "mailto:*" }
      ]
    }
  ]
}
