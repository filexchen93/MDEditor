{
  "name": "mdeditor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "dev": "pnpm --filter @mdeditor/desktop dev",
    "desktop": "pnpm --filter @mdeditor/desktop tauri",
    "fixtures:spec": "node scripts/fetch-spec-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "benchmark": "node tests/performance/benchmark.mjs && node tests/performance/editor-benchmark.mjs",
    "build:native-test": "pnpm --filter @mdeditor/desktop build && pnpm --filter @mdeditor/desktop exec tauri build --debug --no-bundle --features webdriver --config src-tauri/tauri.webdriver.conf.json --ci",
    "build:native-manual": "pnpm --filter @mdeditor/desktop build && pnpm --filter @mdeditor/desktop exec tauri build --debug --no-bundle --features test-data-override --config src-tauri/tauri.manual.conf.json --ci",
    "test:native": "wdio run wdio.native.conf.mjs",
    "test:native:restart": "node scripts/native-restart-test.mjs",
    "test:native:manual": "pnpm build:native-manual && node scripts/native-manual-acceptance.mjs",
    "test:native:manual:prepare": "pnpm build:native-manual && node scripts/native-manual-acceptance.mjs --prepare-only",
    "test:native:manual:verify": "node scripts/native-manual-evidence.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.10.0",
    "@wdio/cli": "9.29.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/tauri-service": "1.3.0",
    "axe-core": "4.10.3",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "expect-webdriverio": "5.7.0",
    "globals": "^17.11.0",
    "prettier": "^3.7.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.18",
    "webdriverio": "9.29.1"
  }
}
